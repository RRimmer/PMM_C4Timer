// PMM_C4Timer — таймер C4 на панораме.
// Комментарии // и /* */ и запятая после последнего элемента разрешены.
// После правки: css_pmm_c4 reload в консоли сервера (Commands и UpdateInterval — после перезапуска плагина).
{
  // false — плагин ничего не показывает.
  "Enabled": true,

  // Скомпилированный layout в клиентском аддоне (с _c на конце).
  "LayoutPath": "panorama/layout/custom_game/pmm_c4timer.vxml_c",

  // Вид для тех, кто не выбирал сам:
  //   1 — цифры, 2 — полоса, 3 — кольцо, 4 — плашка с метками 5 с / 10 с,
  //   5 — сегменты, 6 — вертикальная шкала, 8 — чип как у таймера раунда, 9 — таймер и прогресс дефьюза.
  "DefaultStyle": 4,

  // Место для тех, кто не выбирал сам:
  //   top — под игроками, radar — под радаром, cross — под прицелом, bottom — внизу, right — справа.
  "DefaultPosition": "top",

  // Какие виды и места игрок может выбрать в !c4.
  "Styles": [1,2,3,4,5,6,8,9],
  "Positions": ["top","radar","cross","bottom","right"],

  // false — у всех вид и место по умолчанию, !c4 только включает и выключает таймер.
  "AllowPlayerChoice": true,

  // Кому показывать таймер.
  "Show": {
    "AliveCT": true,       // живые CT
    "AliveT": true,        // живые T
    "Dead": true,          // мёртвые
    "Spectators": true     // наблюдатели
  },

  // Кому показывать, что бомбу обезвреживают: «Обезвреживают», кит, процент, успевает или нет (вид 9).
  // Кому нельзя — видит только таймер бомбы; сервер не отправляет ему данные о дефьюзе вообще.
  "ShowDefuse": {
    "AliveCT": true,       // живые CT
    "AliveT": false,       // живые T
    "Dead": true,          // мёртвые
    "Spectators": true     // наблюдатели
  },

  // Команды в чат: css_c4 = !c4 и /c4.
  "Commands": ["css_c4","css_c4timer"],

  // Как часто обновлять таймер, секунд (0.05 – 1). Полосы между обновлениями двигаются плавно.
  "UpdateInterval": 0.1,

  // Цвет по оставшемуся времени: с WarnSeconds — жёлтый, с CritSeconds — красный и мигание.
  "WarnSeconds": 20,
  "CritSeconds": 10,

  // Сколько секунд держать таймер на экране после дефьюза или взрыва (0 — сразу убрать).
  "HideDelay": 0,

  // Подробный лог.
  "Debug": false,

  "ConfigVersion": 1
}
