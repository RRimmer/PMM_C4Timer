<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>PMM_C4Timer</AssemblyName>
        <RootNamespace>PMM_C4Timer</RootNamespace>
        <Version>0.1.0</Version>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CounterStrikeSharp.API" Version="1.0.377">
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
        <!-- MenuManagerApi.dll must live only in shared/MenuManagerApi -->
        <ProjectReference Include="..\MenuManagerApi\MenuManagerApi.csproj">
            <Private>false</Private>
        </ProjectReference>
    </ItemGroup>

    <ItemGroup>
        <None Update="lang\*.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
